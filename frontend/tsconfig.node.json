{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    /*
     * Where the compiled configs go, which is nowhere anybody reads.
     *
     * Typechecking these three files used to write a .js beside each of them, and
     * Vite looks for vite.config.js before vite.config.ts - so the built app was
     * configured by whatever the last typecheck had emitted, and an edit to the
     * TypeScript could sit there doing nothing. The emit is not wanted at all; it
     * is sent out of the way because a project in a composite build cannot refuse
     * to emit.
     */
    "outDir": "./node_modules/.tmp/config-build",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "capacitor.config.ts"]
}
