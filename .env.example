# Copy to .env and fill in. Nothing here has a default: docker compose will fail
# loudly on a missing value rather than starting a half-configured stack.

# Published images, set by the deploy pipeline.
API_IMAGE=ghcr.io/OWNER/split-everything-api:latest
WEB_IMAGE=ghcr.io/OWNER/split-everything-web:latest

# Public address. PUBLIC_HOST is the bare hostname for the Traefik rule;
# PUBLIC_URL is the full origin the app and invite links use.
PUBLIC_HOST=split.example.com
PUBLIC_URL=https://split.example.com

# Traefik
CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=traefik

# Database
POSTGRES_DB=split_everything
POSTGRES_USER=split
POSTGRES_PASSWORD=change-me

# At least 32 characters. Rotating it signs everyone out.
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# Google OAuth client id, from the Google Cloud console. The same value goes into
# the web image at build time.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Web Push, for browsers. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Native push. Leave blank until the Capacitor shells are built: the senders are
# no-ops when unconfigured and delivery falls back to Web Push.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.splitEverything.app
APNS_PRIVATE_KEY=

# Email, for magic-link invites. Leave blank to log invites instead of sending
# them; links and QR codes still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=split-everything@example.com

# Daily dumps, kept this many days.
BACKUP_RETENTION_DAYS=30
