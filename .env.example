# Copy to .env and fill in. Nothing here has a default: docker compose will fail
# loudly on a missing value rather than starting a half-configured stack.

# The Docker Hub account the images were pushed to, and the tag to run. CI pushes
# latest plus three semver tags on every version tag, so this can be as loose as
# "latest" or as tight as "v1.4.2".
DOCKERHUB_USERNAME=OWNER
APP_TAG=latest

# The full origin the app is served on. Invite links, the JWT issuer and the CORS
# list are all built from it, so it has to be what a browser actually types.
PUBLIC_URL=https://split.example.com

# Database
POSTGRES_DB=split_everything
POSTGRES_USER=split
POSTGRES_PASSWORD=change-me

# At least 32 bytes: the API refuses to start with anything shorter rather than
# padding it out to look accepted. Generate one with: openssl rand -base64 48
# Rotating it signs everyone out.
JWT_SIGNING_KEY=change-me-to-a-long-random-string

# Google OAuth client id, from the Google Cloud console. The web image needs the
# same value at build time, where it is a repository variable named
# GOOGLE_CLIENT_ID rather than an entry here: Vite inlines it into the bundle.
GOOGLE_CLIENT_ID=

# Browser notifications, which the app asks for from the profile. Generate with:
#   npx web-push generate-vapid-keys
# Leave blank and the app works; the notification switch simply has nothing behind
# it. VAPID_SUBJECT is a contact address, not a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Native push, for a Capacitor build. Uncomment the matching lines in the compose
# file when there is an APK or a TestFlight build to send to.
#
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY=

# How many days of nightly database dumps to keep.
BACKUP_RETENTION_DAYS=30
